{
  "name": "@beansmile/testmate-widget",
  "version": "1.0.0",
  "description": "TestMate feedback widget — embed user feedback collection in any website (fork of makethisbetter-js 1.30.1)",
  "type": "module",
  "main": "./dist/testmate.cjs",
  "module": "./dist/testmate.esm.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/testmate.iife.js",
  "jsdelivr": "./dist/testmate.iife.js",
  "sideEffects": [
    "./dist/*.js",
    "./dist/*.cjs",
    "./src/index.ts"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/testmate.esm.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/testmate.cjs"
      }
    },
    "./package.json": "./package.json",
    "./standalone": "./dist/testmate.standalone.js",
    "./iife": "./dist/testmate.iife.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "prepare": "patch-package && npm run build",
    "prepack": "npm run build && node scripts/check-dist.mjs",
    "dev": "vite serve demo",
    "build": "vite build && vite build --config vite.standalone.config.ts && vite build --config vite.iife.config.ts && tsc --emitDeclarationOnly --declaration --declarationDir dist && node scripts/fix-dts-specifiers.mjs && node scripts/bundle-dts.mjs && node scripts/copy-recorder.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:install": "bash test-install-methods.sh",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.5.0",
    "jsdom": "^24.0.0",
    "patch-package": "^8.0.0",
    "playwright": "^1.62.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "@rrweb/record": "^2.1.0",
    "html-to-image": "^1.11.11"
  },
  "keywords": [
    "testmate",
    "feedback",
    "widget",
    "ai",
    "mcp",
    "claude-code",
    "cursor",
    "vibe-coding",
    "agent",
    "bug-reporting",
    "annotation"
  ],
  "homepage": "https://testmate.beansmile.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beansmile/testmate-widget.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
